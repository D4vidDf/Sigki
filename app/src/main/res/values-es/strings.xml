    <!-- About -->
    <string name="about_title">Acerca de SigKi</string>
    <string name="about_description">SigKi es una combinación de \u0022Sig\u0022 (Signal/Señal) y \u0022Ki\u0022 (el sonido que hace el Halcón Peregrino, el animal más rápido del mundo). \n\nSimboliza las posibilidades al realizar una acción (señal) rápida de tu teléfono. Al tomar el relevo de la invocación estándar del asistente, SigKi reemplaza los chatbots de IA genéricos con un acceso ultrarrápido a las herramientas que realmente usas a diario.</string>
    <string name="developer_github_url">https://github.com/d4viddf</string>

